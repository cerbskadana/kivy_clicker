#:import from_hex kivy.utils.get_color_from_hex
#:import colormap kivy.utils.colormap


#:set main_color "#a5d2ff"
#:set main_color_dark "#F37C12"
#:set light_background "#c5c0ff"
#:set light_text "#4A4A4A"
#:set light_button "#65a0ff"
#:set light_button_pressed "#BDB2FF"
#:set dark_background "#2F578A"
#:set dark_text "#5d7e86"
#:set dark_button "#232F72"
#:set dark_button_pressed "#121358"

# Спільний стиль кнопок меню
# Спільний стиль кнопок меню
<ButtonMenu@Button>:
    font_size: "20sp"
    size_hint: 1, 0.15
    background_normal: ''
    # ДОДАНО: кольори кнопки залежать від вибраної теми.
    background_color: from_hex(light_button) if app.theme == "light" else from_hex(dark_button)
    color: from_hex(light_text) if app.theme == "light" else from_hex(dark_text)
    on_press:
        # ДОДАНО: колір кнопки під час натискання для обох тем.
        self.background_color = from_hex(light_button_pressed) if app.theme == "light" else from_hex(dark_button_pressed)
    on_release:
        # ДОДАНО: повернення кольору й звук після натискання кнопки.
        self.background_color = from_hex(light_button) if app.theme == "light" else from_hex(dark_button)
        app.play_button_sound()
<Widget>:
    font_name: 'assets/fonts/SankofaDisplay-Regular.ttf'
<Screen>:
    canvas.before:
        Color:
            rgba: from_hex(light_background) if app.theme == "light" else from_hex(dark_background)
        Rectangle:
            pos: self.pos
            size: self.size

<Label>:
    color: from_hex(light_text) if app.theme == "light" else from_hex(dark_text)

<MenuScreen>:
    

    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "20dp"

        Image:
            source: "assets/images/img.png"
            size_hint: 1, 0.5

        Label:
            text: "Main Menu"
            font_size: "40sp"
            size_hint: 1, 0.2

        ButtonMenu:
            text: "PLAY"
            on_press: root.go_game()

        ButtonMenu:
            text: "SETTINGS"
            on_press: root.go_settings()

        ButtonMenu:
            text: "EXIT"
            on_press: root.exit_app()


<GameScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "20dp"

        Label:
            text: "Game Screen"
            font_size: "40sp"

        # Ось тут треба додати динамічний текст для рахунку:
        Label:
            text: "Score: " + str(root.score)
            font_size: "30sp"
            size_hint: 1, 0.2

        # Вказуємо id: fish для віджета риби
        Fish:
            id: fish
            size_hint: 1, 0.65

        ButtonMenu:
            text: "Back to Menu"
            on_press: root.go_menu()

        # Вказуємо id: level_complete для напису перемоги
        Label:
            id: level_complete
            text: "LEVEL COMPLETE!"
            font_size: "35sp"
            color: 0, 1, 0, 1
            opacity: 0


<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "20dp"

        Label:
            text: "Settings"
            font_size: "40sp"

        ButtonMenu:
            text: "light Theme"
            on_press: app.set_theme("light")

        ButtonMenu:
            text: "dark Theme"
            on_press: app.set_theme("dark")

        ButtonMenu:
            text: "music 1"
            on_press: app.play_music("assets/sounds/music1.mp3")
        ButtonMenu:
            text: "music 2"
            on_press: app.play_music("assets/sounds/music2.mp3")
        ButtonMenu:
            text: "Back to Menu"
            on_press: root.go_menu()